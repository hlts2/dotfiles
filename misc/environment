#
# This file is parsed by pam_env module
#
# Syntax: simple "KEY=VAL" pairs on separate lines

# Wayland-native apps (GTK4, Qt6) auto-detect the Wayland input method
# protocol, so GTK_IM_MODULE / QT_IM_MODULE should be left unset to avoid
# conflicting frontends. Keep them commented for reference.
# GTK_IM_MODULE=fcitx5
# QT_IM_MODULE=fcitx5

# XMODIFIERS is still needed for XWayland / X11 apps.
XMODIFIERS=@im=fcitx5
DefaultIMModule=fcitx5
