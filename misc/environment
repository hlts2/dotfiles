#
# This file is parsed by pam_env module
#
# Syntax: simple "KEY=VAL" pairs on separate lines

# Required for XWayland-based GTK/Qt apps (Chrome, Slack, Electron apps, etc.)
# Without these, IME falls back to a floating "OverTheSpot" box that requires
# Enter-to-commit, which is jarring.
# fcitx5 will emit a harmless warning about Wayland vs GTK_IM_MODULE; ignore it.
GTK_IM_MODULE=fcitx5
QT_IM_MODULE=fcitx5
XMODIFIERS=@im=fcitx5
DefaultIMModule=fcitx5
